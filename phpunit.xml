<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings for PHPUnit. Run every test with: vendor/bin/phpunit  (or: composer test) -->
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>

APP_NAME="The Bloom"
APP_ENV=local
APP_DEBUG=true
BASE_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=the_bloom
DB_USER=root
DB_PASS=

YOUTUBE_API_KEY=

# Used once by `php database/migrate.php` to create the first admin.
# Leave ADMIN_PASSWORD empty to get a random one printed in the terminal.
ADMIN_EMAIL=admin@thebloom.local
ADMIN_PASSWORD=
